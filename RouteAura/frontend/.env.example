# Backend API base (include /api/v1). Production: your Render URL, e.g. https://routeaura-api.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1
# Socket.IO server origin (no path). Production: your Render URL
VITE_SOCKET_URL=http://localhost:5000
# Public Razorpay key id (safe to expose; the secret stays on the backend). Only needed when PAYMENT_MODE=razorpay
VITE_RAZORPAY_KEY_ID=
# Show demo-login shortcuts on the login page (demos only; never enable with real users)
VITE_SHOW_DEMO=false
