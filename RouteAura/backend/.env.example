# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Frontend origin(s) allowed by CORS (comma separated). In production: your Vercel URL, e.g. https://routeaura.vercel.app
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# DB_MODE=local  -> uses MONGODB_LOCAL_URI
# DB_MODE=atlas  -> uses MONGODB_URI (MongoDB Atlas connection string)
DB_MODE=local
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/routeaura
MONGODB_URI=

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- Payments ----------
# mock      -> built-in demo gateway (no real money, great for demonstrations)
# razorpay  -> Razorpay test/live keys below are required
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Seat locks ----------
SEAT_LOCK_MINUTES=10

# ---------- Email (optional; notifications are still stored in-app when unset) ----------
EMAIL_USER=
EMAIL_PASS=
